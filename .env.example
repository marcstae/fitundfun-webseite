# PocketBase — comma-separated list of origins allowed to access the PB API
# Include the URL where the website is served (the web container's public URL)
PB_ORIGINS=http://192.168.1.169:3843

# Public URL where browsers can reach PocketBase (used by Next.js at build time)
NEXT_PUBLIC_PB_URL=http://192.168.1.169:8090

# Public URL where the website is served (used for sitemap, metadata, SEO)
SITE_URL=http://192.168.1.169:3843

# Secret for Next.js on-demand revalidation API (/api/revalidate)
REVALIDATE_SECRET=CHANGE_THIS_GENERATE_A_RANDOM_SECRET

# One-time credentials for the first admin login on a fresh installation.
# The cockpit forces an immediate password change and migrations never overwrite it later.
ADMIN_EMAIL=admin@example.ch
ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_INITIAL_PASSWORD

# Internal server secret (min. 32 random characters, e.g. `openssl rand -base64 48`).
# Signs the family-access cookie and is the password of the internal PocketBase family account.
# NEVER give this to families: their shared family password is set in the cockpit (/admin/konto).
FAMILY_ACCESS_EMAIL=familie@fitundfun.local
FAMILY_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# Optional: where PocketBase stores its data (default ./pb_data next to the compose file).
# PB_DATA_DIR=/home/marcstae/docker-data/fitundfun-webseite/pb_data
